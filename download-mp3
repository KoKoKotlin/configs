#!/bin/sh
# Download a video's audio as MP3 with thumbnail and metadata.
if [ -z "$1" ]; then
    echo "Usage: download-mp3 <video-url>" >&2
    exit 1
fi

exec yt-dlp "$1" \
    --extract-audio --audio-format mp3 --audio-quality 0 \
    --embed-thumbnail \
    --embed-metadata \
    --output "%(title)s.%(ext)s"
