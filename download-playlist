#!/bin/sh
# Download a whole YouTube playlist, numbered in playlist order.
# Accepts a playlist ID or a full playlist URL.
if [ -z "$1" ]; then
    echo "Usage: download-playlist <playlist-id|playlist-url>" >&2
    exit 1
fi

case "$1" in
    http*) url="$1" ;;
    *)     url="https://www.youtube.com/playlist?list=$1" ;;
esac

exec yt-dlp "$url" \
    --yes-playlist \
    --format 'bestvideo*+bestaudio/best' \
    --output "%(playlist_index)02d-%(title)s.%(ext)s"
