// ~/.config/waybar/config — Hyprland bar
{
	"layer": "top",
	"position": "top",
	"modules-left": [
		"hyprland/workspaces",
		"hyprland/submap"
	],
	"modules-center": [
		"hyprland/window"
	],
	"modules-right": [
		"cpu",
		"memory",
		"network",
		"pulseaudio",
		"idle_inhibitor",
		"clock",
		"tray"
	],
	"hyprland/submap": {
		"format": "{}"
	},
	"hyprland/window": {
		"max-length": 80,
		"separate-outputs": true
	},
	"cpu": {
		"format": "CPU: {usage}%",
		"tooltip": false
	},
	"memory": {
		"format": "MEM: {used:0.1f}G"
	},
	"network": {
		"family": "ipv4",
		"format-wifi": "<span color='#589df6'></span> <span color='gray'>{essid}</span> {frequency} <span color='#589df6'>{signaldBm} dB</span> <span color='#589df6'>⇵</span> {bandwidthUpBits}/{bandwidthDownBits}",
		"format-ethernet": "ETH: {ipaddr}/{cidr}",
		"format-linked": "{ifname} (No IP)",
		"format-disconnected": "Disconnected ⚠",
		"format-alt": "{ifname}: {ipaddr}/{cidr}",
		"interval": 5
	},
	"pulseaudio": {
		"format": "{icon} {volume}% {format_source}",
		"format-muted": "🔇 {format_source}",
		"format-bluetooth": "{icon} {volume}% {format_source}",
		"format-bluetooth-muted": "🔇 {format_source}",
		"format-source": " {volume}%",
		"format-source-muted": "",
		"format-icons": {
			"headphones": "",
			"handsfree": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": [
				"🔈",
				"🔉",
				"🔊"
			]
		},
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
		"on-click-middle": "pavucontrol"
	},
	// Click the idle icon to keep the screen from locking (e.g. videos)
	"idle_inhibitor": {
		"format": "<span color='#589df6'>{icon}</span>",
		"format-icons": {
			"activated": "",
			"deactivated": ""
		}
	},
	"clock": {
		"interval": 1,
		"format": "{:%d-%m-%y %H:%M}",
		"tooltip-format": "{:%Y-%m-%d | %H:%M:%S}"
	},
	"tray": {
		"spacing": 10
	},
	// Optional modules: add them to modules-right to use them
	"custom/disk_home": {
		"format": "/home: {} ",
		"interval": 30,
		"exec": "df -h --output=avail $HOME | tail -1 | tr -d ' '"
	},
	"custom/disk_root": {
		"format": "/: {}",
		"interval": 30,
		"exec": "df -h --output=avail / | tail -1 | tr -d ' '"
	},
	"temperature": {
		"critical-threshold": 80,
		"format": "<span color='#e88939'>{icon}</span> {temperatureC}°C",
		"format-icons": [
			"",
			"",
			""
		]
	},
	// Needs notmuch with a configured mail setup
	"custom/mail": {
		"format": "Mail: {}",
		"interval": 30,
		"exec": "notmuch count tag:flagged OR tag:inbox AND NOT tag:killed"
	}
}
